<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/bg_app">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="match_parent" android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingLeft="22dp" android:paddingRight="22dp" android:paddingTop="30dp" android:paddingBottom="24dp">

        <TextView android:text="JARVIS" android:textColor="#F4F5FF" android:textSize="13sp"
            android:textStyle="bold" android:letterSpacing="0.28" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="COMPANION" android:textColor="#777E93" android:textSize="10sp"
            android:letterSpacing="0.18" android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <ImageView android:layout_width="142dp" android:layout_height="142dp" android:layout_marginTop="28dp"
            android:src="@drawable/orb" android:contentDescription="JARVIS orb" android:elevation="14dp"/>

        <TextView android:id="@+id/status" android:text="Not paired" android:textColor="#C9CDDC" android:textSize="14sp"
            android:gravity="center" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="24dp">
            <TextView android:text="PAIR DEVICE" android:textColor="#8D93A8" android:textStyle="bold" android:textSize="11sp"
                android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/pairCode" android:hint="6-character Pair Code" android:hintTextColor="#555D72"
                android:textColor="#FFFFFF" android:textColorHint="#555D72" android:textSize="18sp" android:gravity="center"
                android:letterSpacing="0.20" android:inputType="textCapCharacters" android:maxLength="6" android:singleLine="true"
                android:background="@drawable/bg_input" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="54dp"/>
            <Button android:id="@+id/pair" android:text="PAIR / CONNECT" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/bg_button" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="14dp">
            <TextView android:text="COMMAND" android:textColor="#8D93A8" android:textStyle="bold" android:textSize="11sp"
                android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <EditText android:id="@+id/command" android:hint="Ask JARVIS..." android:hintTextColor="#555D72" android:textColor="#FFFFFF"
                android:background="@drawable/bg_input" android:singleLine="true" android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="54dp"/>
            <Button android:id="@+id/send" android:text="SEND COMMAND" android:textColor="#FFFFFF" android:textStyle="bold"
                android:background="@drawable/bg_button" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="52dp"/>
        </LinearLayout>

        <Button android:id="@+id/accessibility" android:text="ENABLE ANDROID UI CONTROL" android:textColor="#C7CAD7"
            android:background="@drawable/bg_button_secondary" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="50dp"/>

        <TextView android:text="Trusted once · reconnects automatically until revoked" android:textColor="#5F667A" android:textSize="11sp"
            android:gravity="center" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
