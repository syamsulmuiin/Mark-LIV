<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/status" android:text="Not paired" android:textSize="18sp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/pairCode" android:hint="6-character Pair Code"
        android:inputType="textCapCharacters" android:maxLength="6" android:singleLine="true"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/pair" android:text="PAIR / CONNECT"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/accessibility" android:text="ENABLE ANDROID UI CONTROL"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/command" android:hint="Command JARVIS"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/send" android:text="SEND COMMAND"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Pair Code is required only for first-time trust. After pairing, this device reconnects automatically until it is revoked in JARVIS. Native capabilities and Android Accessibility control are unchanged."
        android:paddingTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
