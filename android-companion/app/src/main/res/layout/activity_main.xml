<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout android:id="@+id/pairPanel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:text="JARVIS" android:textColor="#F4F5FF" android:textSize="18sp" android:textStyle="bold"
            android:letterSpacing="0.24" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="PAIR DEVICE" android:textColor="#777E93" android:textSize="11sp" android:letterSpacing="0.16"
            android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/pairCode" android:hint="6-character Pair Code" android:textColor="#FFFFFF"
            android:textColorHint="#555D72" android:textSize="20sp" android:gravity="center" android:letterSpacing="0.20"
            android:inputType="textCapCharacters" android:maxLength="6" android:singleLine="true" android:background="@drawable/bg_input"
            android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="58dp"/>
        <Button android:id="@+id/pair" android:text="PAIR" android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="@drawable/bg_button" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="54dp"/>
        <TextView android:id="@+id/pairStatus" android:text="Enter the Pair Code shown by JARVIS" android:textColor="#777E93"
            android:textSize="12sp" android:gravity="center" android:layout_marginTop="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/voicePanel" android:visibility="gone" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingTop="42dp" android:paddingBottom="28dp">
        <TextView android:text="JARVIS" android:textColor="#F4F5FF" android:textSize="13sp" android:textStyle="bold"
            android:letterSpacing="0.28" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="LIVE" android:textColor="#777E93" android:textSize="10sp" android:letterSpacing="0.18"
            android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <com.jarvis.companion.JarvisOrbView android:id="@+id/orb" android:layout_width="match_parent" android:layout_height="280dp"
            android:contentDescription="JARVIS live reactor orb"/>
        <TextView android:id="@+id/status" android:text="Connecting..." android:textColor="#C9CDDC" android:textSize="16sp"
            android:gravity="center" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Speak naturally" android:textColor="#5F667A" android:textSize="12sp" android:gravity="center"
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <ScrollView android:id="@+id/transcriptScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp" android:fillViewport="true">
            <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C9CDDC" android:textSize="13sp" android:lineSpacingExtra="5dp" android:padding="8dp"/>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/interrupt" android:text="INTERRUPT" android:textColor="#C7CAD7" android:background="@drawable/bg_button_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
            <Space android:layout_width="8dp" android:layout_height="1dp"/>
            <Button android:id="@+id/endConversation" android:text="END" android:textColor="#FFFFFF" android:background="@drawable/bg_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/>
        </LinearLayout>
        <Button android:id="@+id/accessibility" android:layout_marginTop="8dp" android:text="ENABLE PHONE CONTROL" android:textColor="#C7CAD7"
            android:background="@drawable/bg_button_secondary" android:layout_width="match_parent" android:layout_height="50dp"/>
    </LinearLayout>
</FrameLayout>
